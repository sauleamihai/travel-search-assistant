PORT=3000
GROQ_API_KEY=your_groq_api_key_here
SERPAPI_API_KEY=your_serpapi_api_key_here
SEARCHAPI_API_KEY=your_searchapi_api_key_here
# Optional: enables an Apify "flight-price-scraper" fallback when Google
# Flights returns no results (aggregates Google Flights, Kiwi, Travelpayouts,
# Ryanair, EasyJet, Wizz Air, and Norwegian). Billed per-run/per-result on
# your Apify account. Leave blank to disable the fallback.
APIFY_TOKEN=your_apify_api_token_here
